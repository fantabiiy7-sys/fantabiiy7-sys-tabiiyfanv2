# Supabase loyiha sozlamalari: Project Settings → API
# Faqat "anon / publishable" kalitni yozing. "service_role" kalitni HECH QACHON bu yerga qo'ymang.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Fayllar saqlanadigan Supabase Storage bucket nomi (schema.sql bilan bir xil bo'lsin)
VITE_STORAGE_BUCKET=materials
